+      "<h3>" + esc(item.name) + "</h3>" +
+      (item.description ? '<p class="cat-desc">' + esc(item.description) + "</p>" : "") +
+      '<div class="cat-price">' + esc(C.formatPrice(item)) + "</div>" +
+      includes +
+      '<div class="cat-book"><a href="' + esc(C.whatsappLink(item)) + '" target="_blank" rel="noopener noreferrer">' + cta + "</a></div>" +
+      "</article>";
+  }
+
+  function group(title, items, kind) {
+    if (!items.length) return "";
+    return '<div class="cat-group-title">' + title + '</div><div class="cat-grid">' +
+      items.map(function (i) { return card(i, kind); }).join("") + "</div>";
+  }
+
+  function showCategory(id) {
+    document.querySelectorAll(".cat-section[data-cat]").forEach(function (s) {
+      s.style.display = (id === "all" || s.dataset.cat === id) ? "" : "none";
+    });
+    document.querySelectorAll(".cat-tab").forEach(function (t) {
+      var on = t.dataset.cat === id;
+      t.classList.toggle("active", on);
+      t.setAttribute("aria-selected", on ? "true" : "false");
+    });
+    try {
+      history.replaceState(null, "", id === "all" ? "services.html" : "services.html?category=" + encodeURIComponent(id));
+    } catch (e) {}
+  }
+
+  function fail() {
+    root.innerHTML = '<div class="cat-state"><p>We couldn\'t load our services right now.</p>' +
+      '<p><a href="https://wa.me/919945095453" target="_blank" rel="noopener noreferrer">WhatsApp us</a> or ' +
+      '<a href="tel:9945095453">call 9945095453</a> and we\'ll help you directly.</p>' +
+      '<p><a href="services.html">Try again</a></p></div>';
+  }
+
+  C.load().then(function (cat) {
+    var live = cat.categories.filter(function (c) {
+      return [].concat(cat.services, cat.packages, cat.addons).some(function (i) { return i.categoryId === c.id; });
+    });
+    if (!live.length) {
+      root.innerHTML = '<div class="cat-state"><p>Our catalog is being updated.</p>' +
+        '<p><a href="https://wa.me/919945095453" target="_blank" rel="noopener noreferrer">WhatsApp us</a> for prices.</p></div>';
+      return;
+    }
+
+    tabsEl.innerHTML = '<button class="cat-tab" role="tab" data-cat="all">All</button>' +
+      live.map(function (c) {
+        return '<button class="cat-tab" role="tab" data-cat="' + esc(c.id) + '">' + esc((c.icon ? c.icon + " " : "") + c.name) + "</button>";
+      }).join("");
+
+    root.innerHTML = live.map(function (c) {
+      function mine(list) { return list.filter(function (i) { return i.categoryId === c.id; }); }
+      return '<section class="cat-section" id="cat-' + esc(c.id) + '" data-cat="' + esc(c.id) + '">' +
+        "<h2>" + esc((c.icon ? c.icon + " " : "") + c.name) + "</h2>" +
+        (c.description ? '<p class="cat-lede">' + esc(c.description) + "</p>" : "") +
+        group("Services", mine(cat.services), "service") +
+        group("Packages", mine(cat.packages), "package") +
+        group("Add-ons", mine(cat.addons), "addon") +
+        "</section>";
+    }).join("");
+
+    tabsEl.addEventListener("click", function (e) {
+      var b = e.target.closest(".cat-tab");
+      if (b) showCategory(b.dataset.cat);
+    });
+    showCategory(live.some(function (c) { return c.id === wanted; }) ? wanted : "all");
+    icons();
+  }).catch(function (err) { console.error("[catalog]", err); fail(); });
+
+  icons();
+})();
+</script>
+</body>
+</html>
